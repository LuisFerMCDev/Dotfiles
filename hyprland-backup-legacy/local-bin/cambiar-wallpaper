#!/bin/bash

WALLPAPER_DIR="$HOME/Imágenes/Wallpapers"
STATE_FILE="$HOME/.cache/current-wallpaper"

mkdir -p "$HOME/.cache"

SELECCION=$(find "$WALLPAPER_DIR" -maxdepth 1 -type f \
    \( -iname "*.jpg" -o -iname "*.jpeg" -o -iname "*.png" \) \
    -printf "%f\n" | sort | wofi --dmenu --prompt "Wallpaper")

[ -z "$SELECCION" ] && exit 0

WALLPAPER="$WALLPAPER_DIR/$SELECCION"

pkill swaybg

swaybg -i "$WALLPAPER" -m fill &

echo "$WALLPAPER" > "$STATE_FILE"
