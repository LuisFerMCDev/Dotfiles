#!/bin/bash

SIGNAL=$(nmcli -t -f IN-USE,SIGNAL dev wifi list | awk -F: '$1=="*"{print $2; exit}')

ICON_DIR="/home/luisfernando/.config/waybar/icons"

if [ -z "$SIGNAL" ]; then
    echo "$ICON_DIR/wifi-offline.svg"
elif [ "$SIGNAL" -lt 25 ]; then
    echo "$ICON_DIR/wifi-weak.svg"
elif [ "$SIGNAL" -lt 50 ]; then
    echo "$ICON_DIR/wifi-ok.svg"
elif [ "$SIGNAL" -lt 75 ]; then
    echo "$ICON_DIR/wifi-good.svg"
else
    echo "$ICON_DIR/wifi-excellent.svg"
fi
