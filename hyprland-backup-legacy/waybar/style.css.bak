* {
    font-family: sans-serif;
    font-size: 14px;
}

window#waybar {
    background: rgba(20, 20, 20, 0.92);
    color: #ffffff;
}

#workspaces button {
    padding: 0 10px;
    color: #888888;
    background: transparent;
    border: none;
}

#workspaces button.active {
    color: #ffffff;
}

#clock,
#network,
#pulseaudio,
#battery {
    padding: 0 12px;
}
