#!/bin/bash
set -euo pipefail

if [ -z "${1:-}" ]; then
    echo "Uso: set-greeter-wallpaper /ruta/a/la/imagen.jpg"
    exit 1
fi

IMG="$(realpath "$1")"
if [ ! -f "$IMG" ]; then
    echo "Error: El archivo no existe: $IMG"
    exit 1
fi

EXT="${IMG##*.}"
DEST="/usr/share/sddm/themes/sddm-astronaut-theme/Backgrounds/custom_bg.${EXT}"

exec pkexec bash -c "
cp -f '$IMG' '$DEST'
chmod 644 '$DEST'
sed -i 's|^Background=.*|Background=\"Backgrounds/custom_bg.${EXT}\"|' /usr/share/sddm/themes/sddm-astronaut-theme/Themes/astronaut.conf
echo '✅ Fondo de SDDM Astronaut actualizado con éxito a: $IMG'
"
